{
  "extends": "@jmp/config/typescript/node.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test/**", "node_modules", "dist"]
}
