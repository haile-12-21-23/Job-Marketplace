# Server Configuration
PORT=3000

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@localhost:5432/jmp_dev?schema=public
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/jmp_dev?schema=public

# Optional: Shadow Database URL for Prisma migrations (development only)
# Required if your PostgreSQL user lacks permissions to create temporary shadow databases
SHADOW_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/jmp_shadow?schema=public
