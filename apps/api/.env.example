# Node Environment (development | test | production)
NODE_ENV=development

# Server Configuration
PORT=3000

# Log Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173

# Public Frontend Base URL (used to construct verification links; must use https:// when NODE_ENV=production)
APP_WEB_URL=http://localhost:5173

# Email Verification Token & Resend Rate-Limit Settings
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_IP_MAX=10
EMAIL_VERIFICATION_RESEND_IP_WINDOW_SECONDS=900
EMAIL_VERIFICATION_RESEND_EMAIL_MAX=3
EMAIL_VERIFICATION_RESEND_EMAIL_WINDOW_SECONDS=900

# Password Reset Token & Rate-Limit Settings
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_IP_MAX=10
PASSWORD_RESET_RATE_LIMIT_IP_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT_EMAIL_MAX=3
PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
PASSWORD_RESET_CONFIRM_RATE_LIMIT_IP_MAX=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_IP_WINDOW_SECONDS=900

# Email Delivery Configuration (development | http; NODE_ENV=production requires EMAIL_PROVIDER=http and https:// endpoint)
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@jobmarketplace.local
# Required when EMAIL_PROVIDER=http:
# EMAIL_HTTP_ENDPOINT=https://api.emailprovider.example.com/v1/send
# EMAIL_HTTP_API_KEY=replace-with-provider-api-key

# Authentication Session & JWT Configuration
# Generate a local high-entropy secret with: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=replace-with-openssl-rand-hex-32-local-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_ACCESS_TOKEN_ISSUER=job-marketplace-api
AUTH_ACCESS_TOKEN_AUDIENCE=job-marketplace-web
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_IP_MAX=10
AUTH_LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_EMAIL_MAX=5
AUTH_LOGIN_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
TRUST_PROXY=false

# PostgreSQL Database Connection URL
# For Docker Compose (PostgreSQL 18.7 on default host port 5433):
# DATABASE_URL=postgresql://jmp_user:replace-with-a-local-only-password@localhost:5433/jmp_dev?schema=public
#
# For native local PostgreSQL (default host port 5432):
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/jmp_dev?schema=public
DATABASE_URL=postgresql://jmp_user:replace-with-a-local-only-password@localhost:5433/jmp_dev?schema=public

# Optional: Shadow Database URL for Prisma migrations (development only)
# Required if your PostgreSQL user lacks permissions to create temporary shadow databases
SHADOW_DATABASE_URL=postgresql://jmp_user:replace-with-a-local-only-password@localhost:5433/jmp_shadow?schema=public
