# Local Docker Compose Environment for PostgreSQL 18.7
#
# Usage:
#   cp .env.docker.example .env.docker
#   # Customize the local-only password in .env.docker
#   docker compose --env-file .env.docker up -d postgres
#
# DO NOT commit .env.docker with real credentials.

POSTGRES_USER=jmp_user
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=jmp_dev
POSTGRES_PORT=5433
